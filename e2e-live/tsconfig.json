{
  // Type-checks the fork's live suite under web's own rules. Playwright only transpiles, so without
  // this a wrong type ships unnoticed. This directory has no node_modules of its own: packages and
  // @types resolve from web/, the same copy the runner loads.
  //     cd web && bunx tsc --noEmit -p ../e2e-live/tsconfig.json
  "extends": "../web/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../web/src/*"],
      "@playwright/test": ["../web/node_modules/@playwright/test"]
    },
    "typeRoots": ["../web/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts", "specs/*.ts"]
}
