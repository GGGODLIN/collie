<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>讓 Collie 在背景保持執行，靈動島才會持續更新。只用粗略位置，不會記錄或上傳。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>選「永遠」後，用捷徑或控制中心重開靈動島時也能在背景持續更新。只用粗略位置，不會記錄或上傳。</string>
	<key>CollieURL</key>
	<string>$(COLLIE_URL)</string>
	<key>CollieShowDetail</key>
	<string>$(ISLAND_SHOW_DETAIL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>collieisland</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
