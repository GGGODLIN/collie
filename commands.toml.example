# Your own rows for Collie's Agent-commands palette. Copy to your plugin config dir, next to `.env`:
#   cp commands.toml.example "$(herdr plugin config-dir herdr.collie)/commands.toml"
#
# On a Claude pane, your rows appear first and exact-name rows override the maintained reference
# catalog without lowering its dangerous classification (ADR 0064). Other harnesses still replace
# their catalog with your matching rows (ADR 0018). With every row commented out, every pane stays
# as shipped.
#
# Edits are picked up live — no restart, no reload of the bridge. Reload the page to see them.
#
# Fields: `command` (required, leading slash; a space after it is an arg hint), `description`,
# `scope` (a herdr agent name — omit it and the row addresses every pane), `confirm` (dangerous
# styling plus two-tap confirmation when the row is also a direct action with `bar = true`).
# These strings are served to every browser that can read this Collie: labels, not secrets.

# A row scoped to one agent — omp's /fork-in-herdr is registered by a plugin, so no shipped catalog
# can carry it.
# [[commands]]
# scope = "omp"
# command = "/fork-in-herdr"
# description = "Fork this conversation into a new herdr tab"

# No scope: every pane, including agents Collie ships no catalog for.
# [[commands]]
# command = "/standup"
# description = "Post today's standup, then wait for review"

# Your own brake on a direct-action row. The palette only fills the composer; with `bar = true`,
# `confirm = true` requires two taps before the actions row sends it.
# [[commands]]
# command = "/deploy"
# description = "Deploy staging"
# confirm = true
